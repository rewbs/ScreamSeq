static void liveDirectPluginCables(const PluginState &effect,uint32_t rate,uint32_t block) {
  auto document=Document::demo();enable(*document);auto native=document->native();std::vector<PluginState> rack;
  for(unsigned i=0;i<3;++i){auto state=effect;state.instanceID="direct-host-"+std::to_string(i);rack.push_back(state);native.mixer.buses.back().inserts.push_back(state.instanceID);}
  Renderer reference(document->serialize(),rate),renderer(document->serialize(),rate);PluginChain dry({},rate,true),host(rack,rate,true);dry.attachInstruments(reference,&document->native());host.attachInstruments(renderer,&native);
  std::array<float,8192> plain{},actual{};uint32_t lastEdit=0,token=0,physical=0;bool sounding=false;const auto warm=uint32_t(std::ceil(rate*.031));
  for(uint32_t position=0;position<15000;){auto count=std::min(block,15000-position);for(auto boundary:{2048u,6144u,10240u})if(boundary>position)count=std::min(count,boundary-position);
    if(position==2048||position==6144||position==10240){if(position==2048)native.mixer.pluginConnections={{rack[0].instanceID,0,rack[2].instanceID,0,-12.041199826559248,true}};else if(position==6144)native.mixer.pluginConnections.push_back({rack[0].instanceID,0,rack[1].instanceID,0,-12.041199826559248,true});else native.mixer.pluginConnections.clear();
      auto plan=host.prepareMixerRouting(native);check(plan&&host.publishMixerRouting(plan),"Actual AU/VST direct audio cable publishes without replacing the running vendor");lastEdit=position;
      if(!token){auto &observation=host.signalObservation();auto found=std::find_if(observation.ports.begin(),observation.ports.end(),[](const auto &p){return p.route&&p.route->kind=="plugin-connection";});check(found!=observation.ports.end(),"Direct plugin cable publishes an exact contribution observation");token=uint32_t(found-observation.ports.begin()+1);const auto source=std::find_if(observation.ports.begin(),observation.ports.end(),[&](const auto &p){return p.key=="plugin:"+rack[0].instanceID+"/out/0";});check(source!=observation.ports.end(),"Physical source output observation exists");physical=uint32_t(source-observation.ports.begin()+1);observation.scope.watch(token);}
    }
    uint64_t alloc,free,locks;tracker_audit_begin();dry.beginRenderBlock();host.beginRenderBlock();dry.syncTransport(reference);host.syncTransport(renderer);reference.render(plain.data(),count);renderer.render(actual.data(),count);const bool okay=dry.process(plain.data(),count)&&host.process(actual.data(),count);tracker_audit_end(&alloc,&free,&locks);
    check(okay&&alloc+free+locks==0,"Actual direct cables render without callback allocation/free/locks");
    if(!lastEdit||position>=lastEdit+warm){const double scale=position<2048||position>=10240?.125:position<6144?.1875:.21875;for(uint32_t i=0;i<count*2;++i){sounding|=std::abs(plain[i])>1e-5;check(std::abs(actual[i]-plain[i]*scale)<2e-6,"Direct plugin fan-in/out differs from independent dry-render scaling");}
      if(token){const auto meter=host.signalObservation().read(token);if(position<10240){check(meter.available&&meter.fresh&&std::abs(meter.routeGain-.25)<1e-12&&meter.compensation==0,"Direct cable scope identifies its accepted contribution and gain");const auto source=host.signalObservation().read(physical);check(source.fresh&&std::abs(meter.rmsLeft-source.rmsLeft*.25)<2e-6,"Direct cable observation must measure its own gained samples");}else check(!meter.available,"Removed direct cable observation must retire");}
    }
    check(reference.telemetry().frames==renderer.telemetry().frames,"Direct cable edit moved the transport clock");position+=count;
  }
  check(sounding&&host.mixerRoutingReady(),"Direct cable fixture did not complete a real audio handoff");
  auto invalid=native;invalid.mixer.pluginConnections={{rack[2].instanceID,0,rack[0].instanceID,0,0,false}};const auto ports=host.signalObservation().ports.size();bool rejected=false;try{host.prepareMixerRouting(invalid);}catch(const std::invalid_argument&){rejected=true;}check(rejected&&host.mixerRoutingReady()&&host.signalObservation().ports.size()==ports,"Disabled processor feedback must reject before replacing audible routing or publishing meters");
}
