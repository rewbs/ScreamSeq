  "contracts": [
    {
      "id": "API-INTEGER-TYPES",
      "phase": "P6a",
      "status": "unresolved",
      "finding": "Windows pattern.get and plugin slot validation reject integer-valued reals; the Mac validator accepts finite integral numbers. This is method-specific; Windows DocumentOperations already accepts integral reals.",
      "sources": [
        "windows/Api/SessionAdapter.hpp",
        "windows/Session/PluginOperations.cpp",
        "windows/Session/DocumentOperations.cpp",
        "mac/Bridge/AutomationValidation.hpp"
      ]
    },
    {
      "id": "API-ORDER-MOVE",
      "phase": "P3a",
      "status": "unresolved",
      "finding": "Windows order.edit omits move/destination; Mac supports them. No-op destination probes isolate field acceptance; actual reordering and history are separate acceptance cases.",
      "sources": [
        "windows/Session/DocumentOperations.cpp",
        "mac/Bridge/TrackerSessionAPI.inc"
      ]
    },
    {
      "id": "API-PLUGIN-POSITION",
      "phase": "P4b",
      "status": "unresolved",
      "finding": "Windows plugin.move accepts direction and dryRun; Mac also supports absolute position.",
      "sources": [
        "windows/Session/PluginOperations.cpp",
        "mac/Bridge/TrackerSessionAPI.inc"
      ]
    },
    {
      "id": "API-PLUGIN-DRY-RUN",
      "phase": "P4b",
      "status": "unresolved",
      "finding": "Windows plugin parameter/bypass writes accept dryRun while Mac rejects that field. Add consistent preparation semantics rather than removing Windows validation.",
      "sources": [
        "windows/Session/PluginOperations.cpp",
        "mac/Bridge/TrackerSessionAPI.inc"
      ]
    },
    {
      "id": "API-GRAPH-GESTURE",
      "phase": "P5",
      "status": "unresolved",
      "finding": "Mac graph.plugin.set accepts a gesture token for coalesced parameter Undo. Windows rejects gesture. Field acceptance is not proof of history coalescing.",
      "sources": [
        "windows/Session/GraphPluginOperations.inc",
        "mac/Bridge/GraphPluginAPI.inc"
      ]
    },
    {
      "id": "API-REPLAY-ERROR",
      "phase": "P6a",
      "status": "unresolved",
      "finding": "Mac retains eligible non-busy errors; Windows retains successful writes and classified committed/unknown outcomes. Probe invalid-ID reuse separately from exact successful replay. Neither cache is durable.",
      "sources": [
        "windows/Api/SessionAdapter.hpp",
        "mac/App/AutomationServer.swift"
      ]
    },
    {
      "id": "API-PLUGIN-NOOP",
      "phase": "P4b",
      "status": "unresolved",
      "finding": "On original F04, Windows accepts a stable plugin identity, but assigning the already-current Enabled parameter creates a plugin Undo entry and revision. Preserve this as a defect; inspect retained after-save bytes before changing commit semantics. Mac no-op behavior remains a runtime prediction.",
      "sources": [
        "windows/Session/PluginOperations.cpp",
        "mac/Bridge/TrackerSessionAPI.inc"
      ]
    }
  ]
