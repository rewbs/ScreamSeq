{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreamSeq parameter activity and recorded automation requests",
  "description": "Shared Mac request contracts. Activity is transient; recorded edits use guarded chronological song history.",
  "oneOf": [
    {
      "description": "List prepared rack processors and independent graph copies. Graph copies appear during playback preparation.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "method": {
          "const": "parameter.activity.targets"
        },
        "params": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "description": "Read the prepared parameter catalog for one processor copy.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "method": {
          "const": "parameter.activity.parameters"
        },
        "params": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "description": "Read controlling sources and editing links; disabled sources remain visible.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "method": {
          "const": "parameter.activity.sources"
        },
        "params": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "parameter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "target",
            "parameter"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "description": "Select the session parameter capture. Transient, no expectedRevision or song Undo. Idempotent unless clear is true.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "method": {
          "const": "parameter.activity.watch"
        },
        "params": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "parameter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "clear": {
              "type": "boolean"
            }
          },
          "required": [
            "target",
            "parameter"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "description": "Read bounded host-delivered values and source contributions after a cursor. Reset cursor when token changes; one shared selection per session.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "method": {
          "const": "parameter.activity.get"
        },
        "params": {
          "type": "object",
          "properties": {
            "after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "description": "Read paginated recorded automation in absolute 48000 Hz song frames.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "method": {
          "const": "automation.recorded.get"
        },
        "params": {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "parameter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "required": [
            "plugin",
            "parameter"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "description": "Upsert, move or remove a recorded point by stable plugin identity. Stops playback, preserves other points and supports plugin Undo; dryRun is non-mutating.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "method": {
          "const": "automation.recorded.edit"
        },
        "params": {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "parameter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29030400000
            },
            "newFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29030400000
            },
            "value": {
              "type": "number"
            },
            "remove": {
              "type": "boolean"
            },
            "dryRun": {
              "type": "boolean"
            },
            "expectedRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "plugin",
            "parameter",
            "frame",
            "expectedRevision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    }
  ]
}
