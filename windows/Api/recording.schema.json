{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreamSeq Windows recording take requests",
  "description": "Shared precise-note takes pinned to a document and base revision. Windows timestamps are decimal unsigned 64-bit QPC values converted to 100 ns units, never UI arrival time. A stopped take commits in one document Undo. Invalid or stale commits retain the take.",
  "type": "object",
  "required": ["jsonrpc", "id", "method", "params"],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 80},
    "method": {"enum": ["recording.get", "recording.start", "recording.capture", "recording.stop", "recording.commit", "recording.discard"]},
    "params": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"method": {"const": "recording.get"}}}, "then": {"properties": {"params": {"maxProperties": 0}}}},
    {"if": {"properties": {"method": {"const": "recording.start"}}}, "then": {"properties": {"params": {
      "required": ["expectedRevision", "channels", "instrument"], "additionalProperties": false,
      "properties": {
        "expectedRevision": {"$ref": "#/$defs/revision"},
        "channels": {"type": "array", "minItems": 1, "maxItems": 127, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 65535}, "description": "Distinct raw note columns, each below the current song channel count."},
        "instrument": {"type": "integer", "minimum": 1, "maximum": 255},
        "quantization": {"type": "integer", "minimum": 0, "maximum": 65536},
        "latencyMS": {"type": "number", "minimum": -500, "maximum": 500}
      }
    }}}},
    {"if": {"properties": {"method": {"const": "recording.capture"}}}, "then": {"properties": {"params": {
      "required": ["expectedRevision", "take", "events"], "additionalProperties": false,
      "properties": {
        "expectedRevision": {"$ref": "#/$defs/revision"}, "take": {"$ref": "#/$defs/take"},
        "events": {"type": "array", "maxItems": 1024, "items": {
          "type": "object", "required": ["timestamp", "status", "note", "velocity"], "additionalProperties": false,
          "properties": {
            "timestamp": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[0-9]+$", "description": "Unsigned 64-bit decimal host time; overflow rejects the whole batch."},
            "status": {"type": "integer", "minimum": 128, "maximum": 191},
            "note": {"type": "integer", "minimum": 0, "maximum": 127},
            "velocity": {"type": "integer", "minimum": 0, "maximum": 127}
          },
          "allOf": [
            {"if": {"properties": {"status": {"minimum": 160, "maximum": 175}}}, "then": false},
            {"if": {"properties": {"status": {"minimum": 176}}}, "then": {"properties": {"note": {"enum": [120, 123]}}}}
          ]
        }}
      }
    }}}},
    {"if": {"properties": {"method": {"enum": ["recording.stop", "recording.discard"]}}}, "then": {"properties": {"params": {
      "required": ["expectedRevision", "take"], "additionalProperties": false,
      "properties": {"expectedRevision": {"$ref": "#/$defs/revision"}, "take": {"$ref": "#/$defs/take"}}
    }}}},
    {"if": {"properties": {"method": {"const": "recording.commit"}}}, "then": {"properties": {"params": {
      "required": ["expectedRevision", "take"], "additionalProperties": false,
      "properties": {
        "expectedRevision": {"$ref": "#/$defs/revision"}, "take": {"$ref": "#/$defs/take"},
        "replaceRows": {"type": "boolean"}, "dryRun": {"type": "boolean"}
      }
    }}}}
  ],
  "$defs": {
    "revision": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000]+$"},
    "take": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000]+$"}
  }
}
