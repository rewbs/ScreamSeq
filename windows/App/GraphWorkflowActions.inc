inline void GraphWorkflowWindow::execute(int id,bool dryRun) {
  requireWrite();Json p={{"dryRun",dryRun}};std::string method;
  if(id>=groupCreate&&id<=groupExport){const bool song=graph_.is_null();method=song?"graph.song.group.":"graph.group.";if(!song)p["graph"]=graph_;
    if(id==groupCreate){method+="create";p["nodes"]=selectedNodes();require(!p["nodes"].empty(),"Select the processors to group");p["parent"]=choice(parent,false);p["name"]=text(name);}
    else{p["group"]=choice(group);require(!p["group"].is_null(),"Choose an existing processing group");method+=id==groupUpdate?"update":id==groupRemove?"remove":"export";if(id!=groupRemove)p["name"]=text(name);if(id==groupUpdate){p["x"]=finite(x,0,100000);p["y"]=finite(y,0,100000);}}
  }else if(id>=addEffect&&id<=setParameter){require(!graph_.is_null(),"Choose a reusable graph for processor patching");p["graph"]=graph_;
    if(id==addEffect){method="graph.node.add";p["kind"]="plugin";const auto plugin=chosen(processor);const auto &rack=catalog_.at("plugins");const auto item=std::find_if(rack.begin(),rack.end(),[&](const auto &entry){return entry.at("id")==plugin;});require(item!=rack.end(),"Captured rack effect no longer exists");p["slot"]=item->at("slot");p["x"]=240;p["y"]=120;const auto selected=choice(edge,false);if(!selected.is_null())p["insertEdge"]=selected;}
    else {const auto selected=selectedNodes();require(!selected.empty(),"Select the effect processors");if(id==insert||id==detach||id==heal){p["nodes"]=selected;method=id==insert?"graph.nodes.insert":"graph.nodes.detach";if(id==insert)p["edge"]=choice(edge);else p["remove"]=id==heal;}
      else{require(selected.size()==1,"Select one recipe effect");p["node"]=selected[0];if(id==bypass){method="graph.plugin.bypass";const auto &ns=definition().at("nodes");const auto n=std::find_if(ns.begin(),ns.end(),[&](const auto &n){return n.at("id")==selected[0];});require(n!=ns.end()&&n->at("kind")=="plugin","Select an effect processor");p["bypass"]=!n->at("plugin").value("bypass",false);}
      else{method="graph.plugin.set";const auto parameter=choice(pluginParameter);require(parameter.value("writable",false),"The parameter is read-only");p["parameters"]=Json::array({{{"id",parameter.at("id")},{"value",finite(pluginValue,parameter.at("min").get<double>(),parameter.at("max").get<double>())}}});}}}
  }else if(id>=sourceAdd&&id<=sourceRemove){method=id==sourceAdd?"graph.song.source.add":id==sourceUpdate?"graph.song.source.update":"graph.song.source.remove";
    if(id==sourceRemove)p["nodes"]=Json::array({chosen(source)});
    else{Json s={{"name",text(sourceName)},{"rate",finite(rate,0,10000)},{"phase",finite(phase,0,1)},{"attack",finite(attack,0,10000)},{"release",finite(release,0,10000)},{"controller",integer(controller,127)},{"amount",finite(amount,0,1)},{"audioBus",choice(audioBus)},{"audioPlugin",choice(audioPlugin)},{"output",integer(output,63)},{"preFader",boolean(preFader)},{"noteTarget",choice(noteTarget)},{"noteInstrument",choice(noteInstrument)}};
      require(s["audioBus"]==""||s["audioPlugin"]=="","Choose either a follower bus or rack output, not both");if(id==sourceAdd){s["kind"]=choice(sourceKind);s["x"]=80;s["y"]=80;}else p["node"]=chosen(source);p["source"]=std::move(s);}
  }else if(id==modSet||id==modRemove){method=id==modSet?"graph.song.modulation.set":"graph.song.modulation.remove";
    if(id==modRemove){const auto e=choice(connection);require(!e.is_null(),"Choose an existing modulation cable");p["connections"]=Json::array({{{"source",e.at("source")},{"plugin",e.at("plugin")},{"parameter",e.at("parameter")}}});}
    else{p["source"]=chosen(modSource);p["plugin"]=chosen(modPlugin);p["parameter"]=choice(modParameter);p["minimum"]=finite(minimum,-1,1);p["maximum"]=finite(maximum,-1,1);p["enabled"]=boolean(enabled);p["quantized"]=boolean(quantized);const auto old=choice(connection,false);if(!old.is_null())p["replace"]={{"source",old.at("source")},{"plugin",old.at("plugin")},{"parameter",old.at("parameter")}};}
  }else if(id>=regionAdd&&id<=collapseNodes){auto presentationValue=presentation();auto &regions=presentationValue["regions"];
    if(id==collapseNodes){const auto selected=selectedNodes();require(!selected.empty(),"Select the nodes to collapse or expand");auto &collapsed=presentationValue["collapsedNodes"];const bool all=std::all_of(selected.begin(),selected.end(),[&](const auto &n){return std::find(collapsed.begin(),collapsed.end(),n)!=collapsed.end();});for(const auto &n:selected){auto it=std::find(collapsed.begin(),collapsed.end(),n);if(all){if(it!=collapsed.end())collapsed.erase(it);}else if(it==collapsed.end())collapsed.push_back(n);}}
    else {const auto selected=choice(region,false);auto old=std::find_if(regions.begin(),regions.end(),[&](const auto &r){return r.at("id")==selected;});
      if(id==regionRemove){require(old!=regions.end(),"Choose an existing annotation");regions.erase(old);}
      else {size_t used=0;const auto color=std::stoul(field(regionColor),&used,16);require(used==field(regionColor).size()&&color<=0xffffff,"Enter a six-digit RGB color");Json r={{"kind",choice(regionKind)},{"title",text(regionTitle)},{"text",text(regionText)},{"x",finite(regionX,-100000,100000)},{"y",finite(regionY,-100000,100000)},{"width",finite(regionWidth,120,100000)},{"height",finite(regionHeight,60,100000)},{"color",color},{"scope",choice(regionScope)},{"collapsed",boolean(regionCollapsed)}};r["nodes"]=r["kind"]=="comment"?Json::array():selectedNodes();if(r["kind"]=="comment")r["collapsed"]=false;
        if(id==regionSet){require(old!=regions.end(),"Choose an existing annotation");r["id"]=old->at("id");*old=std::move(r);}else{unsigned suffix=1;do{r["id"]="windows-frame-"+std::to_string(suffix++);}while(std::any_of(regions.begin(),regions.end(),[&](const auto &other){return other.at("id")==r["id"];}));regions.push_back(std::move(r));}}
    }writePresentation(std::move(presentationValue),dryRun);refreshAfterWrite(dryRun);return;
  }else if(id>=rerouteAdd&&id<=rerouteClear){auto value=presentation();auto &cables=value["cables"];const auto selected=choice(cable);auto found=std::find_if(cables.begin(),cables.end(),[&](auto c){c.erase("points");return c==selected;});
    if(id==rerouteAdd){if(found==cables.end()){auto c=selected;c["points"]=Json::array();cables.push_back(std::move(c));found=cables.end()-1;}require(found->at("points").size()<64,"A cable has at most 64 reroute points");(*found)["points"].push_back({finite(rerouteX,-100000,100000),finite(rerouteY,-100000,100000)});}
    else {require(found!=cables.end(),"The cable has no reroute points");if(id==rerouteClear)cables.erase(found);else{auto &points=(*found)["points"];const auto index=choice(reroutePoint).get<size_t>();require(index<points.size(),"Select a current reroute point");if(id==rerouteMove)points[index]={finite(rerouteX,-100000,100000),finite(rerouteY,-100000,100000)};else{points.erase(points.begin()+index);if(points.empty())cables.erase(found);}}}
    writePresentation(std::move(value),dryRun);refreshAfterWrite(dryRun);return;
  }
  require(!method.empty(),"Choose a graph action");auto result=call(method,std::move(p),true);refreshAfterWrite(dryRun);
  if(id==sourceAdd&&!dryRun&&!dirty_&&result.contains("node")){const auto &values=choices_[source];const auto it=std::find(values.begin(),values.end(),result.at("node"));if(it!=values.end()){const auto index=it-values.begin();ScreamSeq::NativeInputGate::present(controls_.at(source),CB_SETCURSEL,index,0);acceptedSelection_[source]=index;loadSelectedFields(source);}}
}
inline void GraphWorkflowWindow::refreshSignals(){
  const auto selected=choice(port,false);auto result=call("graph.signal.get",Json::object(),false);std::vector<std::pair<std::wstring,Json>> ports;
  for(const auto &p:result.at("ports"))ports.emplace_back(wide(p.at("name").get<std::string>()+" / "+p.at("direction").get<std::string>()+" "+p.at("port").dump()),p.at("key"));signals_=std::move(result);fill(port,ports,selected);
  auto key=choice(port,false);std::wstring summary=L"Prepared ports are available during playback. Listening changes monitoring only.";
  for(const auto &p:signals_.at("ports"))if(p.at("key")==key){summary=wide("Peak "+p.at("peak").dump()+"   RMS "+p.at("rms").dump()+"\r\nLatency "+p.at("processorLatency").dump()+" frames; compensation "+p.at("compensation").dump()+" frames. "+(p.value("clipped",false)?"OVERLOAD ":"")+(p.value("nonFinite",false)?"Invalid samples detected ":"")+(p.value("fresh",false)?"Fresh":"No fresh signal"));break;}set(details,summary);layout();
}
inline void GraphWorkflowWindow::refreshProvenance(){
  const auto plugin=chosen(modPlugin);const auto parameter=choice(modParameter);auto result=call("graph.provenance.get",{{"plugin",plugin},{"parameter",parameter},{"offset",provenanceOffset_},{"limit",64}},false);
  std::vector<std::pair<std::wstring,Json>> sources;for(const auto &s:result.at("sources"))sources.emplace_back(wide(s.at("kind").get<std::string>()+(s.contains("pattern")?" / pattern "+s.at("pattern").dump():"")+" / "+s.at("count").dump()+" events"),s);
  provenance_=std::move(result);fill(provenanceList,sources);set(details,wide(provenance_.at("rule").get<std::string>()));layout();
}
inline void GraphWorkflowWindow::action(int id,unsigned notification){
  if(setting_)return;
  if(id==close){hide();return;}if(id==check){dryRun_=!dryRun_;set(check,dryRun_?L"Actions: check only":L"Actions: apply");return;}if(id==reload){load(false);return;}
  if(pending_&&notification!=EN_CHANGE){if(notification==CBN_SELCHANGE||notification==LBN_SELCHANGE)restorePendingSelection(id);return;}
  if(id==page&&notification==CBN_SELCHANGE){page_=unsigned(SendMessageW(controls_.at(page),CB_GETCURSEL,0,0));KillTimer(window_,3);layout();if(page_==3&&!dirty_&&choices_[modParameter].empty())loadSelectedFields(modPlugin);if(page_==6){refreshSignals();SetTimer(window_,3,120,nullptr);}return;}
  if(id==graph&&notification==CBN_SELCHANGE){if(dirty_){ScreamSeq::NativeInputGate::present(controls_.at(graph),CB_SETCURSEL,acceptedSelection_[graph],0);throw std::runtime_error("Raw fields are retained. Reload before changing graph target.");}graph_=choice(graph,false);setting_=true;try{populate();}catch(...){setting_=false;throw;}setting_=false;++generation_;layout();return;}
  if(id==provenanceList&&notification==LBN_SELCHANGE){const auto at=SendMessageW(controls_.at(id),LB_GETCURSEL,0,0);if(at>=0&&size_t(at)<choices_[id].size())set(details,wide(choices_[id][size_t(at)].dump(2)));return;}
  if(notification==EN_CHANGE&&id!=details){++generation_;dirty_=true;requestPaint();return;}
  if(notification==CBN_SELCHANGE||id==nodes&&notification==LBN_SELCHANGE){if(dirty_&&(id==source||id==group||id==region||id==connection||id==modPlugin||id==cable||id==reroutePoint||id==pluginParameter||id==nodes&&page_==1)){if(id==nodes){ScreamSeq::NativeInputGate::present(controls_.at(nodes),LB_SETSEL,FALSE,-1);for(int i:acceptedNodes_)ScreamSeq::NativeInputGate::present(controls_.at(nodes),LB_SETSEL,TRUE,i);}else ScreamSeq::NativeInputGate::present(controls_.at(id),CB_SETCURSEL,acceptedSelection_[id],0);throw std::runtime_error("Raw fields are retained. Reload before choosing another saved target.");}++generation_;if(rawChoice(id))dirty_=true;if(notification==CBN_SELCHANGE)acceptedSelection_[id]=SendMessageW(controls_.at(id),CB_GETCURSEL,0,0);else if(id==nodes){acceptedNodes_.clear();for(int i=0;i<SendMessageW(controls_.at(nodes),LB_GETCOUNT,0,0);++i)if(SendMessageW(controls_.at(nodes),LB_GETSEL,i,0)>0)acceptedNodes_.push_back(i);}if(id==spectrum){spectrum_=boolean(spectrum);return;}loadSelectedFields(id);requestPaint();return;}
  if(id==sourceCurve){require(current(),"Reload before opening the captured source");require(bool(callbacks_.curve),"Curve editor is unavailable");const auto node=chosen(source);const auto found=std::find_if(catalog_.at("songSources").begin(),catalog_.at("songSources").end(),[&](const auto &s){return s.at("id")==node;});require(found!=catalog_.at("songSources").end()&&found->at("kind")=="automation","Choose an automation source");callbacks_.curve(nullptr,node);return;}
  if(id==inspectActivity){require(bool(callbacks_.activity),"Parameter activity is unavailable");callbacks_.activity(chosen(modPlugin),choice(modParameter).get<uint32_t>());return;}
  if(id==inspectSources){page_=7;ScreamSeq::NativeInputGate::present(controls_.at(page),CB_SETCURSEL,7,0);provenanceOffset_=0;refreshProvenance();return;}
  if(id==provenanceRefresh||id==provenanceNext){if(id==provenanceNext)provenanceOffset_=provenanceOffset_+64>=provenance_.value("total",0u)?0:provenanceOffset_+64;refreshProvenance();return;}
  if(id==provenanceOpen){require(current(),"Song changed; reload the source catalogue");require(bool(callbacks_.provenance),"Source editor is unavailable");const auto at=SendMessageW(controls_.at(provenanceList),LB_GETCURSEL,0,0);require(at>=0&&size_t(at)<choices_[provenanceList].size(),"Choose an existing source");callbacks_.provenance(choices_[provenanceList][size_t(at)]);return;}
  if(id>=signalRefresh&&id<=clearClip){if(id==signalRefresh){refreshSignals();return;}Json p=Json::object();std::string method;
    if(id==scopeStart||id==scopeStop){method="graph.scope.watch";p["port"]=id==scopeStart?choice(port):Json(nullptr);}
    else if(id==listenStart||id==listenStop){method="graph.listen.set";p["port"]=id==listenStart?choice(port):Json(nullptr);if(id==listenStart)p["gainDB"]=finite(listenGain,-60,12);}
    else{method="graph.signal.clear";p["port"]=choice(port);}require(available(),"Document is busy");p["expectedRevision"]=callbacks_.context().at("revision");call(method,std::move(p),false);message_=id==listenStop?"Normal mix restored":"Monitoring updated; musical data is unchanged";refreshSignals();return;
  }
  if(notification==BN_CLICKED)execute(id,dryRun_||(GetKeyState(VK_CONTROL)&0x8000)!=0);
}
