Json groupInput(const SignalGroupInput &p){return {{"source",nativeID(p.source)},{"target",nativeID(p.target)},{"output",p.output},{"input",p.input}};}
SignalGroupInput decodeGroupInput(const Json &p){return {decodeID(field(p,"source")),decodeID(field(p,"target")),uint32_t(integer(optional(p,"output",0),0,63)),uint32_t(integer(optional(p,"input",0),0,63))};}
Json groupDryRoutes(const std::vector<SignalGroupDryRoute> &routes){Json result=Json::array();for(const auto &r:routes)result.push_back({{"input",r.input.source?groupInput(r.input):Json("")},{"output",{{"node",nativeID(r.output.node)},{"port",r.output.port}}}});return result;}
std::vector<SignalGroupDryRoute> decodeGroupDryRoutes(const Json &raw){std::vector<SignalGroupDryRoute> result;for(const auto &r:array(raw,256)){const auto &input=field(r,"input"),&out=field(r,"output");result.push_back({(input.is_null()||input=="")?SignalGroupInput{}:decodeGroupInput(input),{decodeID(field(out,"node")),uint32_t(integer(optional(out,"port",0),0,63))}});}return result;}
Json routeIdentity(const SignalRouteIdentity &r){return {{"kind",r.kind},{"source",r.source},{"target",r.target},{"plugin",r.plugin},{"tap",r.tap},{"input",r.input},{"output",r.output}};}
SignalRouteIdentity decodeRouteIdentity(const Json &r){return {text(field(r,"kind"),32),text(optional(r,"source",""),256),text(optional(r,"target",""),256),text(optional(r,"plugin",""),256),text(optional(r,"tap","post-gain"),32),uint32_t(integer(optional(r,"input",0),0,63)),uint32_t(integer(optional(r,"output",0),0,63))};}
Json songGroupDryRoutes(const std::vector<SignalSongGroupDryRoute> &routes){Json result=Json::array();for(const auto &r:routes)result.push_back({{"input",r.input.kind.empty()?Json(""):routeIdentity(r.input)},{"output",routeIdentity(r.output)}});return result;}
std::vector<SignalSongGroupDryRoute> decodeSongGroupDryRoutes(const Json &raw){std::vector<SignalSongGroupDryRoute> result;for(const auto &r:array(raw,256)){const auto &input=field(r,"input");result.push_back({(input.is_null()||input=="")?SignalRouteIdentity{}:decodeRouteIdentity(input),decodeRouteIdentity(field(r,"output"))});}return result;}
